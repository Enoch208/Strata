# Server-side only. Never expose this value through NEXT_PUBLIC_* variables.
VIDEODB_API_KEY=

# Optional: normally the pipeline reads the persisted collection ID from
# data/archive_manifest.json.
VIDEODB_COLLECTION_ID=

# VideoDB sandbox extraction configuration.
STRATA_EXTRACTION_MODEL=pro
STRATA_EXTRACTION_TEMPERATURE=0
STRATA_CLIP_PADDING_SECONDS=2
